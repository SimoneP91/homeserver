# Backup settings, read by scripts/backup.sh. bootstrap.sh copies this file to
# /etc/homeserver/backup.env (root only, mode 600) the first time: edit THAT copy.
# Shell syntax: no spaces around "=", quote values with spaces.

# Main repository: the USB disk, mounted on /mnt/backup (see docs/06-backup.md).
RESTIC_REPOSITORY=/mnt/backup/restic
# The repository password. Without it the backups CANNOT be read: keep a copy in your password
# manager, not only on this server. `backup.sh init` creates it if missing.
RESTIC_PASSWORD_FILE=/etc/homeserver/restic-password

# The backup refuses to run if this is not a mounted disk (so it never fills the system SSD
# when the USB disk is unplugged). Empty = no check, e.g. for a network repository.
BACKUP_MOUNT=/mnt/backup

# What to back up, separated by spaces. /srv holds this repository, the apps with their secrets
# (devices.yaml, .env) and the infra data; /home holds your development clones.
BACKUP_PATHS="/srv /etc/homeserver /home"
# Patterns of rebuildable things to skip (node_modules, .venv, caches...).
BACKUP_EXCLUDES_FILE=/srv/homeserver/config/backup-excludes.txt

# SQLite databases of running services: copied with SQLite's online backup first, so that the
# backup has a consistent copy without stopping them (Uptime Kuma: choose SQLite at setup).
BACKUP_SQLITE="/srv/data/uptime-kuma/kuma.db"

# Snapshots kept after each run.
BACKUP_KEEP="--keep-daily 7 --keep-weekly 4 --keep-monthly 12"

# Uptime Kuma "Push" monitor URL, called after every successful run: Kuma alerts you when it
# stops arriving. Empty = off.
BACKUP_PUSH_URL=

# ---------------------------------------------------------------- optional: off-site copy --
# A second repository, backed up independently after the main one, e.g.
#   sftp:user@other-house.example:/backups/homeserver
#   s3:https://s3.eu-central-003.backblazeb2.com/my-bucket/homeserver
# Same password file. Put the credentials it needs below (they stay in this root-only file).
OFFSITE_REPOSITORY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
