# LocalClima on the home server. Copy to /srv/apps/localclima/backend/.env:
#   cp /srv/homeserver/apps/localclima/backend.env.example /srv/apps/localclima/backend/.env
# localclima's docker-compose.yml reads it (env_file). Do NOT reuse the .env of the old PC as it
# is: copy over only the settings you had changed on purpose (poll intervals, log level...).

# Behind Caddy: http://localclima.local -> 127.0.0.1:8100 (infra/caddy/sites/localclima.caddy).
# Loopback only: from the LAN the app is reached through Caddy, never directly. 8100 leaves
# 8000 free for a development server (make dev) running next to production.
LOCALCLIMA_HOST=127.0.0.1
LOCALCLIMA_PORT=8100

# The server publishes localclima.local itself (infra/mdns/aliases): the app must not, or the
# two announcements would collide.
LOCALCLIMA_MDNS_HOSTNAME=

# Already set by the image, listed for clarity: the log file and the learned device addresses
# live in the localclima-data volume, mounted on /data.
# LOCALCLIMA_LOG_FILE=/data/localclima.log
# LOCALCLIMA_HOSTS_CACHE_FILE=/data/hosts.json
