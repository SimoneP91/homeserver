[Unit]
Description=Publish the app names (<name>.local) of this server over mDNS
Documentation=file:///srv/homeserver/docs/04-servizi-base.md
Requires=avahi-daemon.service
After=avahi-daemon.service network-online.target
Wants=network-online.target
# Restarting avahi-daemon drops every published record: start again with it.
PartOf=avahi-daemon.service

[Service]
Type=simple
ExecStart=/srv/homeserver/scripts/mdns-aliases.sh /srv/homeserver/infra/mdns/aliases
Restart=always
RestartSec=5
# Talks to avahi-daemon over D-Bus only: no privileges needed.
#
# A static system user (created by bootstrap.sh), not DynamicUser=: on Debian 13 avahi-publish
# run as a dynamic user fails with "Failed to create client object: An unexpected D-Bus error
# occurred", while the same sandbox with a static user works (tested on the server).
User=homeserver-mdns
Group=homeserver-mdns
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
