[Unit]
Description=Nightly backup of the home server
Documentation=file:///srv/homeserver/docs/06-backup.md

[Timer]
# 03:00, before the automatic reboot window of unattended-upgrades (04:30 by default).
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=15min
# Run at the next boot if the server was off at 03:00.
Persistent=true

[Install]
WantedBy=timers.target
